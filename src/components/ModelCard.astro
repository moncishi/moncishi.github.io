---
/**
 * ModelCard — one card per model in the model-list grid (T17).
 *
 * PURE display leaf: the page layer computes every value. No data fetching.
 *
 * Props:
 *  - model:          { id, name, official } where official is the FOUR-tier
 *                    official API price per 1M tokens (¥ CNY official in the
 *                    models yaml; currency may still be USD for some models).
 *                    cacheRead / cacheWrite are nullable — null = 不单列/未提供.
 *  - providerNames:  human labels of the providers carrying this model
 *                    (e.g. ['Command Code Goat', '智谱官方']). Capped at ~4
 *                    visible chips; the remainder collapses into one "+N".
 *  - detailHref:     /models/[id] — the WHOLE card links there.
 *
 *  Renders:
 *   title      — model name (h3 inside the card-wide link)
 *   2×2 prices — grid labeled 输入 / 输出 / 缓存读 / 缓存写. Top two cells are
 *                prominent (label above a large price), bottom two compact
 *                (inline label + price, thinner).
 *   cacheWrite — special-cased: 0 reads as 免费 (static, no toggle) and null
 *                reads as —; both are styled muted. Input / output / cacheRead
 *                fall back to — for null.
 *   chips      — provider availability pills (muted), cap ~4 with +N.
 *
 *  Currency machinery: every money cell carries the [data-price] contract (see
 *  CurrencyToggle.astro) with canonical data-usd / data-cny attrs so the page's
 *  USD/CNY toggle can flip it client-side. The official four-tier price is ¥ CNY
 *  native (official.currency === 'CNY'); the USD view is the FX conversion
 *  (site rate 7.2). SSR text stays the site default (USD); attrs carry both
 *  canonical numbers (data-usd native when official.currency is USD, converted
 *  otherwise).
 */
import {
	isImageOfficial,
	toDisplayCurrency,
	type Currency,
	type OfficialModelPricing,
} from '../lib/pricing';

interface ModelProps {
	id: string;
	name: string;
	official: OfficialModelPricing;
}

interface Props {
	model: ModelProps;
	providerNames: string[];
	detailHref: string;
}

const { model, providerNames = [], detailHref } = Astro.props;
const { official } = model;
const currency = official.currency;

/** Visible chip cap including the trailing "+N" pill when truncated. */
const MAX_CHIPS = 4;
const moreCount =
	providerNames.length > MAX_CHIPS ? providerNames.length - (MAX_CHIPS - 1) : 0;
const shownNames = moreCount > 0 ? providerNames.slice(0, MAX_CHIPS - 1) : providerNames;

/** Treat null / undefined / NaN as absent. */
function normNum(v: number | null | undefined): number | null {
	return typeof v === 'number' && Number.isFinite(v) ? v : null;
}

/** Price cell — up to 3 decimals, trailing zeros trimmed: 15 / 1.25 / 0.088. */
function fmtPrice(n: number): string {
	return n.toFixed(3).replace(/(\.\d*[1-9])0+$|\.0+$/, '$1');
}

/**
 * Canonical number string for a data-usd / data-cny attr (the CurrencyToggle
 * contract): String(parseFloat(attr)) === attr. fmtPrice already strips
 * trailing ".0", so this guard is near-identity — kept per the contract.
 */
function canon3(fmt: string): string {
	return String(parseFloat(fmt)) === fmt ? fmt : String(Number(fmt));
}

/** Convert a native per-1M price to a display currency, canonical ≤3-dp string. */
function displayPrice(native: number, nativeCurrency: Currency, to: Currency): string {
	return canon3(fmtPrice(toDisplayCurrency(native, nativeCurrency, to)));
}

/** One money cell's [data-price] payload (see CurrencyToggle.astro). */
interface Money {
	/** Canonical USD number (the SSR / site-default view). */
	usd: string;
	/** Canonical CNY number (native when official.currency is CNY). */
	cny: string;
	/** USD text to render server-side — `$` + data-usd. */
	ssr: string;
}

/**
 * [data-price] payload for a numeric official price: BOTH canonical views
 * derive from the same native value re-expressed at the site FX (7.2), so
 * data-usd is native when official.currency is USD and the FX conversion when
 * it is CNY. null native → no toggle cell (caller renders —).
 */
function money(native: number | null): Money | null {
	if (normNum(native) === null) return null;
	const usd = displayPrice(native as number, currency, 'USD');
	const cny = displayPrice(native as number, currency, 'CNY');
	return { usd, cny, ssr: `$${usd}` };
}

interface CellContent {
	/** Present → toggleable money cell; absent → static placeholder text. */
	price: Money | null;
	/** Static placeholder when price is absent (— / 免费), muted. */
	text: string;
	muted: boolean;
}

/**
 * One tier cell's content. kind 'money': numeric → toggle cell, null → muted —.
 * kind 'free-or-dash' (缓存写): 0 → static 免费 (never a money cell), null → —,
 * anything else → toggle cell.
 */
function cellContent(
	native: number | null,
	kind: 'money' | 'free-or-dash',
): CellContent {
	if (native === null) return { price: null, text: '—', muted: true };
	if (kind === 'free-or-dash' && native === 0)
		return { price: null, text: '免费', muted: true };
	return { price: money(native), text: '', muted: false };
}

const isImage = isImageOfficial(official);

/** Two prominent cells: label stacked above a large price. */
const primaryCells = isImage
	? [
			{ label: '1K 图像', ...cellContent(official.pricing['1k'] ?? null, 'money') },
			{ label: '2K 图像', ...cellContent(official.pricing['2k'] ?? null, 'money') },
	  ]
	: [
			{ label: '输入', ...cellContent(official.input, 'money') },
			{ label: '输出', ...cellContent(official.output, 'money') },
	  ];

/** Two compact cells: inline label + price on one line. */
const secondaryCells = isImage
	? [
			{ label: '计费方式', price: null, text: '按张计费', muted: true },
			{ label: '模型模态', price: null, text: '图像生成', muted: true },
	  ]
	: [
			{ label: '缓存读', ...cellContent(official.cacheRead, 'money') },
			{ label: '缓存写', ...cellContent(official.cacheWrite, 'free-or-dash') },
	  ];
---

<article>
	<a class="model-card" href={detailHref}>
		<h3 class="mc-title">{model.name}</h3>

		<dl class="mc-prices" aria-label="官方价格">
			{
				primaryCells.map((cell) => (
					<div class="mc-cell mc-cell--primary">
						<dt class="mc-label">{cell.label}</dt>
						{cell.price ? (
							<dd
								class="mc-value"
								data-price
								data-usd={cell.price.usd}
								data-cny={cell.price.cny}
							>
								{cell.price.ssr}
							</dd>
						) : (
							<dd class="mc-value is-muted">{cell.text}</dd>
						)}
					</div>
				))
			}
			{
				secondaryCells.map((cell) => (
					<div class="mc-cell mc-cell--compact">
						<dt class="mc-label">{cell.label}</dt>
						{cell.price ? (
							<dd
								class="mc-value"
								data-price
								data-usd={cell.price.usd}
								data-cny={cell.price.cny}
							>
								{cell.price.ssr}
							</dd>
						) : (
							<dd class:list={{ 'mc-value': true, 'is-muted': cell.muted }}>
								{cell.text}
							</dd>
						)}
					</div>
				))
			}
		</dl>

		{
			providerNames.length > 0 && (
				<footer class="mc-foot">
					<ul class="mc-chips">
						{
							shownNames.map((name) => (
								<li class="mc-chip">{name}</li>
							))
						}
						{
							moreCount > 0 && (
								<li class="mc-chip mc-chip--more" title={`另有 ${moreCount} 个提供商`}>
									+{moreCount}
								</li>
							)
						}
					</ul>
				</footer>
			)
		}
	</a>
</article>

<style>
	.model-card {
		display: flex;
		flex-direction: column;
		gap: 0.625rem;
		height: 100%;
		padding: 0.875rem 0.875rem 0.75rem;
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-card);
		box-shadow: var(--shadow-card);
		color: inherit;
		text-decoration: none;
		transition:
			border-color 150ms ease,
			box-shadow 150ms ease;
	}

	.model-card:hover {
		border-color: color-mix(in srgb, var(--color-accent) 30%, var(--color-border));
		box-shadow:
			0 4px 14px rgb(0 0 0 / 0.08),
			0 2px 4px rgb(0 0 0 / 0.04);
	}

	.mc-title {
		margin: 0;
		font-size: 0.9375rem;
		line-height: 1.4;
		font-weight: 700;
		color: var(--color-text);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
		transition: color 150ms ease;
	}

	.model-card:hover .mc-title {
		color: var(--color-accent);
	}

	/* 2×2 price grid — hairlines drawn as per-cell borders so the outer
	   ring (grid border) and the inner dividers never double up. */
	.mc-prices {
		margin: 0;
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		border: 1px solid var(--color-border);
		border-radius: 0.5rem;
		overflow: hidden;
	}

	/* Column divider (input | output, 缓存读 | 缓存写). */
	.mc-cell:nth-child(odd) {
		border-right: 1px solid var(--color-border);
	}

	/* Row divider under 输入 / 输出. */
	.mc-cell:nth-child(n + 3) {
		border-top: 1px solid var(--color-border);
	}

	.mc-cell {
		display: flex;
		min-width: 0;
		background: color-mix(in srgb, var(--color-text-muted) 3%, var(--color-surface));
	}

	/* Prominent top cells: label above a large price. */
	.mc-cell--primary {
		flex-direction: column;
		align-items: flex-start;
		gap: 0.125rem;
		padding: 0.5rem 0.75rem 0.625rem;
	}

	/* Compact bottom cells: label and price inline on one baseline. */
	.mc-cell--compact {
		flex-direction: row;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.5rem;
		padding: 0.375rem 0.75rem;
	}

	.mc-label {
		font-size: 0.6875rem;
		line-height: 1.4;
		font-weight: 600;
		letter-spacing: 0.04em;
		color: var(--color-text-muted);
		white-space: nowrap;
	}

	.mc-value {
		margin: 0;
		font-variant-numeric: tabular-nums;
		color: var(--color-text);
		white-space: nowrap;
	}

	.mc-cell--primary .mc-value {
		font-size: 1rem;
		line-height: 1.4;
		font-weight: 700;
	}

	.mc-cell--compact .mc-value {
		font-size: 0.8125rem;
		line-height: 1.5;
		font-weight: 600;
	}

	/* null → — and cacheWrite 0 → 免费 read as muted placeholders. */
	.mc-value.is-muted {
		color: var(--color-text-muted);
		font-weight: 500;
	}

	.mc-foot {
		margin-top: auto;
	}

	.mc-chips {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.3125rem;
	}

	.mc-chip {
		display: inline-flex;
		align-items: center;
		max-width: 100%;
		padding: 0.0625rem 0.5rem;
		border-radius: 9999px;
		border: 1px solid var(--color-border);
		background: color-mix(in srgb, var(--color-text-muted) 6%, transparent);
		font-size: 0.6875rem;
		line-height: 1.6;
		font-weight: 500;
		color: var(--color-text-muted);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
		user-select: none;
	}

	.mc-chip--more {
		background: color-mix(in srgb, var(--color-accent) 10%, transparent);
		border-color: color-mix(in srgb, var(--color-accent) 30%, var(--color-border));
		color: var(--color-accent);
	}
</style>
