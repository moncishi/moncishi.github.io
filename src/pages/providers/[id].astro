---
/**
 * /providers/[id] — single-provider model price table (concept 04).
 *
 * For ONE provider, lists every model it carries in the wide 10-column
 * ProviderTable. Derived value metrics (月额度 M、M/货币、货币/M) are computed
 * against DEFAULT_MIX (90/9/1) in USD — see src/lib/data.ts — at build time,
 * plus a CNY twin (same FX as the rest of the site); the rows are then sorted
 * by RAW 货币/M ascending so the best value is #1 and gets ProviderTable's 最佳值
 * highlight. Per-1M price columns stay in the provider's NATIVE currency and
 * ProviderTable converts to USD/CNY for the currency toggle.
 *
 * Structure (top → bottom):
 *   1. Breadcrumb: 订阅商 / {provider name}.
 *   2. Header: provider name (h1) + kind <Badge> + a billing line — for
 *      subscription providers the composed plan "月费 $10 + 7% ≈ $10.7/月 ·
 *      共享额度池" (amount from pricing.actualMonthly); for official providers
 *      the 按量 marker "官方按量 · ¥/1M · 无月费".
 *   3. MixSlider — renders the 90/9/1 usage-mix strip for UX. Live recompute
 *      from its window `mixchange` event is intentionally NOT wired yet (same
 *      T23-note pattern as /models/[id]); the table below is server-rendered
 *      against DEFAULT_MIX and stays static until that ticket lands.
 *   4. ProviderTable — the 10-column wide table (Model|Input|Output|Cache
 *      Read|Cache Write|月度积分|月额度M(90,9,1)|月额度M(95,4,1)|M/货币|货币/M).
 *      Every cell is null-safe: an official provider (no credits / quota /
 *      billing) renders its rows with "—" in the pool-derived columns and is
 *      ranked lowest (its rows carry no computable curPerM, so they sort to
 *      the bottom and never become a 最佳值).
 *
 * getStaticPaths enumerates every providers-collection id; an unknown slug
 * falls through to Astro's built-in 404.
 */
import Badge from '../../components/Badge.astro';
import Layout from '../../layouts/Layout.astro';
import MixSlider from '../../components/MixSlider.astro';
import ProviderTable from '../../components/ProviderTable.astro';
import {
	DEFAULT_MIX,
	MIX_95_4_1,
	formatRateLimitNote,
	planActualMonthly,
	round3,
	type Currency,
	type Plan,
} from '../../lib/pricing';
import {
	computePlanMetrics,
	computeRowMetrics,
	getProvidersWithModels,
	type ProviderWithModels,
} from '../../lib/data';

export interface Props {
	provider: ProviderWithModels;
}

export async function getStaticPaths(): Promise<
	{ params: { id: string }; props: Props }[]
> {
	const providers = await getProvidersWithModels();
	return providers.map((provider) => ({
		params: { id: provider.id },
		props: { provider },
	}));
}

const { provider } = Astro.props;
const isOfficial = provider.kind === 'official';
// Provider's own listing currency — the per-1M price columns carry its native
// prices. Official mock providers list ¥/1M; subscription providers list $.
const currencySymbol: '$' | '¥' = provider.currency === 'CNY' ? '¥' : '$';

/** 1-dp money string, trailing ".0" trimmed: 10.7 → "10.7", 20 → "20". */
function fmtTrim(n: number): string {
	const r = Math.round((n + Number.EPSILON) * 10) / 10;
	const fixed = r.toFixed(1);
	return fixed.endsWith('.0') ? fixed.slice(0, -2) : fixed;
}

// Select active / primary plan: prefer primary plan with baseFee > 0, fallback to first plan
const primaryPlan: Plan | undefined =
	provider.plans && provider.plans.length > 0
		? provider.plans.find((p) => p.baseFee > 0) ?? provider.plans[0]
		: undefined;

// --- Billing line (header) ------------------------------------------------
let billPrimary: string;
let billRest: string;

if (isOfficial) {
	billPrimary = '官方按量';
	billRest = `${currencySymbol}/1M · 无月费，随用随付`;
} else if (primaryPlan && primaryPlan.baseFee > 0) {
	const planSymbol = primaryPlan.currency === 'CNY' ? '¥' : '$';
	const pct = typeof primaryPlan.feePct === 'number' ? primaryPlan.feePct : 0;
	billPrimary = `月费 ${planSymbol}${fmtTrim(primaryPlan.baseFee)}`;
	const extra: string[] = [];
	if (pct > 0) {
		billPrimary += ` + ${pct}%`;
		const actual = planActualMonthly(primaryPlan, primaryPlan.currency);
		extra.push(`≈ ${planSymbol}${fmtTrim(actual)}/月`);
	} else if (pct === 0) {
		extra.push('无附加费');
	}
	extra.push(primaryPlan.quotaType === 'credits' ? '积分额度池' : '共享额度池');
	billRest = extra.join(' · ');
} else {
	billPrimary = '订阅聚合';
	billRest = '按共享额度池计费';
}

// --- ProviderTable rows per Plan --------------------------------------------
type SortableRow = {
	modelId: string;
	modelName: string;
	modelHref: string;
	price: ProviderWithModels['modelRows'][number]['price'];
	nativeCurrency: Currency;
	credits: number | null;
	quotaType?: 'credits' | 'currency' | null;
	quotaCurrency?: Currency | null;
	quota90: number | null;
	quota95: number | null;
	mPerCur: number | null;
	mPerCurCny: number | null;
	curPerM: number | null;
	curPerMCny: number | null;
	_sort: number; // raw curPerM (USD), Infinity when null
};

const plansToRender: (Plan | undefined)[] =
	provider.plans && provider.plans.length > 0 ? provider.plans : [undefined];

const planData = plansToRender.map((plan, planIdx) => {
	const isDefault = planIdx === 0;
	const sortable: SortableRow[] = provider.modelRows.map((row) => {
		const mUsd = plan
			? computePlanMetrics(row.price, plan, DEFAULT_MIX, 'USD', provider.currency, row.modelQuota, row.multiplier)
			: computeRowMetrics(row.price, row.credits, provider.billing, DEFAULT_MIX, 'USD');
		const mCny = plan
			? computePlanMetrics(row.price, plan, DEFAULT_MIX, 'CNY', provider.currency, row.modelQuota, row.multiplier)
			: computeRowMetrics(row.price, row.credits, provider.billing, DEFAULT_MIX, 'CNY');
		const mUsd95 = plan
			? computePlanMetrics(row.price, plan, MIX_95_4_1, 'USD', provider.currency, row.modelQuota, row.multiplier)
			: null;

		const quota90 = mUsd.quotaM !== null ? round3(mUsd.quotaM) : row.quota90;
		const quota95 = mUsd95?.quotaM != null ? round3(mUsd95.quotaM) : row.quota95;

		return {
			modelId: row.modelId,
			modelName: row.modelName,
			modelHref: `/models/${row.modelId}`,
			price: row.price,
			nativeCurrency: provider.currency,
			credits: row.modelQuota ?? (plan ? plan.quotaAmount : row.credits),
			quotaType: plan ? plan.quotaType : null,
			quotaCurrency: plan ? plan.quotaCurrency : null,
			quota90,
			quota95,
			mPerCur: mUsd.mPerCur === null ? null : round3(mUsd.mPerCur),
			mPerCurCny: mCny.mPerCur === null ? null : round3(mCny.mPerCur),
			curPerM: mUsd.curPerM === null ? null : round3(mUsd.curPerM),
			curPerMCny: mCny.curPerM === null ? null : round3(mCny.curPerM),
			_sort: mUsd.curPerM === null ? Number.POSITIVE_INFINITY : mUsd.curPerM,
		};
	});

	sortable.sort((a, b) => a._sort - b._sort);

	const rows = sortable.map(({ _sort, ...row }, i) => ({
		...row,
		rank: i + 1,
		isBest: i === 0,
	}));

	return {
		plan,
		planId: plan?.id ?? 'default',
		rows,
		isDefault,
	};
});

const mixLabel = '缓存90/输入9/输出1';
const pageTitle = provider.name;
const pageDescription = isOfficial
	? `${provider.name} 各模型的官方按量价格明细`
	: `${provider.name} 各模型的月费、月额度与每元产出明细`;
const sectionTitle = isOfficial ? '官方按量价格' : '模型价格与月配额';
const planNote = primaryPlan && !isOfficial ? `（套餐：${primaryPlan.name}）` : '';
const sectionSub = isOfficial
	? '官方 API 按 token 计费，无月费与额度池'
	: `按每元额度降序，第 1 行为最佳值 · 折算配比 ${mixLabel}`;
---

<Layout title={pageTitle} description={pageDescription} activeNav="providers">
	<div class="detail-page">
		<nav class="breadcrumb" aria-label="面包屑">
			<a href="/providers">订阅商</a>
			<span class="bc-sep" aria-hidden="true">/</span>
			<span class="bc-current" aria-current="page">{provider.name}</span>
		</nav>

		<header class="page-head">
			<div class="head-row flex flex-wrap items-center justify-between gap-4">
				<div class="flex items-center gap-3">
					<h1 class="provider-title">{provider.name}</h1>
					<Badge kind={provider.kind} />
				</div>
				<div class="provider-links flex flex-wrap items-center gap-2">
					{provider.websiteUrl && (
						<a
							href={provider.websiteUrl}
							target="_blank"
							rel="noopener noreferrer"
							class="inline-flex items-center gap-1 text-xs px-2.5 py-1 rounded-md border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-300 hover:text-blue-600 dark:hover:text-blue-400 hover:border-blue-400 transition"
							title="访问官网"
						>
							🌐 官网
						</a>
					)}
					{provider.pricingUrl && (
						<a
							href={provider.pricingUrl}
							target="_blank"
							rel="noopener noreferrer"
							class="inline-flex items-center gap-1 text-xs px-2.5 py-1 rounded-md border border-blue-200 dark:border-blue-900/50 bg-blue-50/60 dark:bg-blue-950/30 text-blue-600 dark:text-blue-400 hover:bg-blue-100 dark:hover:bg-blue-900/40 transition font-medium"
							title="查看官方价格与套餐页面"
						>
							🔗 价格 / 订阅页 ↗
						</a>
					)}
					{provider.docUrl && (
						<a
							href={provider.docUrl}
							target="_blank"
							rel="noopener noreferrer"
							class="inline-flex items-center gap-1 text-xs px-2.5 py-1 rounded-md border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-300 hover:text-blue-600 dark:hover:text-blue-400 hover:border-blue-400 transition"
							title="开发接入文档"
						>
							📖 文档
						</a>
					)}
				</div>
			</div>
			<p class="billing-line">
				<span class="bill-primary">{billPrimary}</span>
				{billRest && (
					<span class="bill-rest">
						<span class="bill-sep" aria-hidden="true">·</span>
						{billRest}
					</span>
				)}
			</p>
			{provider.plans && provider.plans.length > 0 && (
				<div class="plans-section space-y-3 pt-3">
					<div class="flex items-center justify-between">
						<h2 class="text-sm font-bold tracking-tight text-slate-700 dark:text-slate-300">
							{provider.plans.length > 1 ? '订阅套餐规格 (点击卡片切换对比明细)' : '订阅套餐规格'}
						</h2>
						{provider.plans.length > 1 && (
							<span class="text-xs text-slate-500 dark:text-slate-400">共 {provider.plans.length} 个可选套餐</span>
						)}
					</div>
					<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3.5">
						{provider.plans.map((pl, idx) => {
							const rateLimit = pl.rateLimit;
							const isSelected = idx === 0;
							const symbol = pl.currency === 'CNY' ? '¥' : '$';
							const quotaSymbol = pl.quotaCurrency === 'CNY' ? '¥' : '$';
							const pct = pl.feePct ?? 0;
							const actual = planActualMonthly(pl, pl.currency);

							return (
								<div
									role={provider.plans.length > 1 ? 'button' : undefined}
									tabindex={provider.plans.length > 1 ? 0 : undefined}
									data-plan-btn={pl.id}
									data-plan-name={pl.name}
									aria-selected={String(isSelected)}
									class={`plan-card relative flex flex-col justify-between p-4 rounded-xl border text-left transition select-none ${
										isSelected
											? 'border-blue-500 bg-blue-50/60 dark:bg-blue-950/30 ring-2 ring-blue-500/30 shadow-sm'
											: 'border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 hover:border-slate-300 dark:hover:border-slate-700'
									} ${provider.plans.length > 1 ? 'cursor-pointer' : ''}`}
								>
									<div>
										<div class="flex items-center justify-between gap-2 mb-2">
											<h3 class="text-base font-bold text-slate-900 dark:text-slate-100">{pl.name}</h3>
											<span class="text-[11px] px-2 py-0.5 rounded-full font-medium bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300">
												{pl.quotaType === 'credits' ? '积分制' : '法币额度池'}
											</span>
										</div>

										<div class="mb-3">
											<div class="flex items-baseline gap-1">
												<span class="text-2xl font-extrabold text-slate-900 dark:text-white tabular-nums">
													{symbol}{pl.baseFee}
												</span>
												<span class="text-xs text-slate-500">/月</span>
												{pct > 0 && (
													<span class="ml-1 text-xs px-1.5 py-0.5 rounded bg-amber-500/10 text-amber-600 dark:text-amber-400 font-medium">
														+{pct}% 费率 ≈ {symbol}{fmtTrim(actual)}
													</span>
												)}
											</div>
											<p class="text-xs font-medium text-blue-600 dark:text-blue-400 mt-0.5">
												包含额度：{pl.quotaType === 'credits'
													? `${pl.quotaAmount.toLocaleString()} 积分`
													: `${quotaSymbol}${pl.quotaAmount} 总额度池`}
											</p>
										</div>

										{rateLimit && (
											<div class="space-y-1.5 py-2 my-2 border-t border-b border-slate-100 dark:border-slate-800/80 text-xs">
												<div class="flex items-center justify-between text-slate-600 dark:text-slate-400">
													<span class="text-slate-400 dark:text-slate-500">5小时限额</span>
													<span class="font-medium text-slate-700 dark:text-slate-300">{rateLimit.rolling5h ?? (rateLimit.hasLimit === 'no' ? '无限制' : '—')}</span>
												</div>
												<div class="flex items-center justify-between text-slate-600 dark:text-slate-400">
													<span class="text-slate-400 dark:text-slate-500">周限额</span>
													<span class="font-medium text-slate-700 dark:text-slate-300">{rateLimit.weekly ?? (rateLimit.hasLimit === 'no' ? '无限制' : '—')}</span>
												</div>
												<div class="flex items-center justify-between text-slate-600 dark:text-slate-400">
													<span class="text-slate-400 dark:text-slate-500">月限额</span>
													<span class="font-medium text-slate-700 dark:text-slate-300">{rateLimit.monthly ?? (rateLimit.hasLimit === 'no' ? '无限制' : '—')}</span>
												</div>
											</div>
										)}

										{pl.poolNote && (
											<p class="text-[11px] leading-relaxed text-slate-500 dark:text-slate-400 mt-2">
												{pl.poolNote}
											</p>
										)}
									</div>

									{provider.plans.length > 1 && (
										<div class="mt-4 pt-2.5 border-t border-slate-100/80 dark:border-slate-800/80 flex items-center justify-between text-xs font-semibold">
											<span class="plan-status text-blue-600 dark:text-blue-400">
												{isSelected ? '✓ 正在查看此套餐' : '点击切换此套餐 →'}
											</span>
										</div>
									)}
								</div>
							);
						})}
					</div>
				</div>
			)}
		</header>

		{primaryPlan && primaryPlan.quotaType === 'currency' && (
			<div class="p-3.5 rounded-xl border border-blue-200 dark:border-blue-900/50 bg-blue-50/50 dark:bg-blue-950/20 text-xs text-blue-900 dark:text-blue-200 flex items-start gap-2.5">
				<span class="text-base leading-none">💡</span>
				<div class="space-y-1">
					<p class="font-semibold">
						动态倍率额度池说明
					</p>
					<p class="text-blue-800/80 dark:text-blue-300/80 leading-relaxed">
						该套餐提供最高 {primaryPlan.quotaCurrency === 'USD' ? '$' : '¥'}{primaryPlan.quotaAmount} 总额度池。不同模型具有不同的单月最大可用法币额度上限与扣费倍率（见下方表格「额度 / 积分」列）。横向性价比与每元额度测算基准假定用户当月 100% 预算均投入该单一模型。
					</p>
				</div>
			</div>
		)}

		<div class="mix-panel">
			<MixSlider label="Token 用量配比（默认 90 / 9 / 1）" />
			<p class="mix-note">
				拖拽配比实时重算即将上线 —— 当前下方表格按默认 90 / 9 / 1 配比计算。
			</p>
		</div>

		<section class="pt-card" aria-label={sectionTitle}>
			<div class="pt-head">
				<div class="pt-titles">
					<h2 class="pt-title">
						{sectionTitle}
						<span class="text-blue-600 dark:text-blue-400 font-normal ml-1.5" data-active-plan-name>
							{planNote}
						</span>
					</h2>
					<p class="pt-sub">{sectionSub}</p>
				</div>
				<span class="pt-count">共 {provider.modelRows.length} 个模型</span>
			</div>

			{planData.map((pd) => (
				<div
					data-plan-table={pd.planId}
					style={pd.isDefault ? '' : 'display: none;'}
					class={pd.isDefault ? '' : 'hidden'}
				>
					{pd.rows.length > 0 ? (
						<ProviderTable rows={pd.rows} mixLabel={mixLabel} />
					) : (
						<p class="pt-empty">该套餐暂无模型数据</p>
					)}
				</div>
			))}
		</section>
	</div>
</Layout>

<script>
	function setupPlanSwitcher() {
		const buttons = document.querySelectorAll('[data-plan-btn]');
		const tables = document.querySelectorAll('[data-plan-table]');
		const activeLabel = document.querySelector('[data-active-plan-name]');

		function activate(planId: string) {
			buttons.forEach((btn) => {
				const isSelected = btn.getAttribute('data-plan-btn') === planId;
				btn.setAttribute('aria-selected', String(isSelected));
				const statusText = btn.querySelector('.plan-status');
				if (isSelected) {
					btn.classList.add('border-blue-500', 'bg-blue-50/60', 'dark:bg-blue-950/30', 'ring-2', 'ring-blue-500/30', 'shadow-sm');
					btn.classList.remove('border-slate-200', 'dark:border-slate-800', 'bg-white', 'dark:bg-slate-900');
					if (statusText) statusText.textContent = '✓ 正在查看此套餐';
				} else {
					btn.classList.remove('border-blue-500', 'bg-blue-50/60', 'dark:bg-blue-950/30', 'ring-2', 'ring-blue-500/30', 'shadow-sm');
					btn.classList.add('border-slate-200', 'dark:border-slate-800', 'bg-white', 'dark:bg-slate-900');
					if (statusText) statusText.textContent = '点击切换此套餐 →';
				}
			});

			tables.forEach((tbl) => {
				const match = tbl.getAttribute('data-plan-table') === planId;
				if (match) {
					tbl.classList.remove('hidden');
					(tbl as HTMLElement).style.display = 'block';
				} else {
					tbl.classList.add('hidden');
					(tbl as HTMLElement).style.display = 'none';
				}
			});

			const activeBtn = Array.from(buttons).find(b => b.getAttribute('data-plan-btn') === planId);
			if (activeBtn && activeLabel) {
				const name = activeBtn.getAttribute('data-plan-name');
				if (name) activeLabel.textContent = `（套餐：${name}）`;
			}
		}

		buttons.forEach((btn) => {
			btn.addEventListener('click', () => {
				const planId = btn.getAttribute('data-plan-btn');
				if (planId) {
					activate(planId);
					try {
						history.replaceState(null, '', `#plan-${planId}`);
					} catch (e) {}
				}
			});
		});

		if (window.location.hash.startsWith('#plan-')) {
			const hashPlan = window.location.hash.replace('#plan-', '');
			if (hashPlan) activate(hashPlan);
		}
	}

	setupPlanSwitcher();
	document.addEventListener('astro:page-load', setupPlanSwitcher);
</script>

<style>
	.detail-page {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
	}

	/* --- Breadcrumb ------------------------------------------------------ */
	.breadcrumb {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.8125rem;
		line-height: 1.5;
		color: var(--color-text-muted);
	}

	.breadcrumb a {
		color: var(--color-text-muted);
		text-decoration: none;
		transition: color 150ms ease;
	}

	.breadcrumb a:hover {
		color: var(--color-accent);
	}

	.bc-sep {
		color: var(--color-border);
		user-select: none;
	}

	.bc-current {
		color: var(--color-text);
		font-weight: 500;
	}

	/* --- Page header ----------------------------------------------------- */
	.page-head {
		display: flex;
		flex-direction: column;
		gap: 0.4375rem;
	}

	.head-row {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.625rem;
	}

	.provider-title {
		margin: 0;
		font-size: 1.875rem;
		font-weight: 800;
		line-height: 1.25;
		letter-spacing: -0.01em;
		color: var(--color-text);
	}

	.billing-line {
		display: flex;
		align-items: baseline;
		flex-wrap: wrap;
		gap: 0.375rem;
		margin: 0;
		font-size: 0.875rem;
		line-height: 1.6;
		color: var(--color-text);
		font-variant-numeric: tabular-nums;
	}

	.bill-primary {
		font-weight: 600;
	}

	.bill-rest {
		color: var(--color-text-muted);
	}

	.bill-sep {
		margin-right: 0.375rem;
		color: var(--color-border);
		user-select: none;
	}

	/* --- Usage-mix strip -------------------------------------------------- */
	.mix-panel {
		width: 100%;
		max-width: 42rem;
