---
/**
 * /providers/[id] — single-provider model price table (concept 04).
 *
 * For ONE provider, lists every model it carries in the wide 10-column
 * ProviderTable. Derived value metrics (月额度 M、M/货币、货币/M) are computed
 * against DEFAULT_MIX (90/9/1) in USD — see src/lib/data.ts — at build time,
 * plus a CNY twin (same FX as the rest of the site); the rows are then sorted
 * by RAW 货币/M ascending so the best value is #1 and gets ProviderTable's 最佳值
 * highlight. Per-1M price columns stay in the provider's NATIVE currency and
 * ProviderTable converts to USD/CNY for the currency toggle.
 *
 * Structure (top → bottom):
 *   1. Breadcrumb: 订阅商 / {provider name}.
 *   2. Header: provider name (h1) + kind <Badge> + a billing line — for
 *      subscription providers the composed plan "月费 $10 + 7% ≈ $10.7/月 ·
 *      共享额度池" (amount from pricing.actualMonthly); for official providers
 *      the 按量 marker "官方按量 · ¥/1M · 无月费".
 *   3. MixSlider — renders the 90/9/1 usage-mix strip for UX. Live recompute
 *      from its window `mixchange` event is intentionally NOT wired yet (same
 *      T23-note pattern as /models/[id]); the table below is server-rendered
 *      against DEFAULT_MIX and stays static until that ticket lands.
 *   4. ProviderTable — the 10-column wide table (Model|Input|Output|Cache
 *      Read|Cache Write|月度积分|月额度M(90,9,1)|月额度M(95,4,1)|M/货币|货币/M).
 *      Every cell is null-safe: an official provider (no credits / quota /
 *      billing) renders its rows with "—" in the pool-derived columns and is
 *      ranked lowest (its rows carry no computable curPerM, so they sort to
 *      the bottom and never become a 最佳值).
 *
 * getStaticPaths enumerates every providers-collection id; an unknown slug
 * falls through to Astro's built-in 404.
 */
import Badge from '../../components/Badge.astro';
import Layout from '../../layouts/Layout.astro';
import MixSlider from '../../components/MixSlider.astro';
import ProviderTable from '../../components/ProviderTable.astro';
import {
	DEFAULT_MIX,
	MIX_95_4_1,
	formatRateLimitNote,
	planActualMonthly,
	round1,
	type Currency,
	type Plan,
} from '../../lib/pricing';
import {
	computePlanMetrics,
	computeRowMetrics,
	getProvidersWithModels,
	type ProviderWithModels,
} from '../../lib/data';

export interface Props {
	provider: ProviderWithModels;
}

export async function getStaticPaths(): Promise<
	{ params: { id: string }; props: Props }[]
> {
	const providers = await getProvidersWithModels();
	return providers.map((provider) => ({
		params: { id: provider.id },
		props: { provider },
	}));
}

const { provider } = Astro.props;
const isOfficial = provider.kind === 'official';
// Provider's own listing currency — the per-1M price columns carry its native
// prices. Official mock providers list ¥/1M; subscription providers list $.
const currencySymbol: '$' | '¥' = provider.currency === 'CNY' ? '¥' : '$';

/** 1-dp money string, trailing ".0" trimmed: 10.7 → "10.7", 20 → "20". */
function fmtTrim(n: number): string {
	const r = Math.round((n + Number.EPSILON) * 10) / 10;
	const fixed = r.toFixed(1);
	return fixed.endsWith('.0') ? fixed.slice(0, -2) : fixed;
}

// Select active / primary plan: prefer primary plan with baseFee > 0, fallback to first plan
const primaryPlan: Plan | undefined =
	provider.plans && provider.plans.length > 0
		? provider.plans.find((p) => p.baseFee > 0) ?? provider.plans[0]
		: undefined;

// --- Billing line (header) ------------------------------------------------
// Subscription: composed from primary plan — 月费 + feePct, actual monthly from
// planActualMonthly — plus the 共享额度池 marker.
// Official: 按量 (pay-as-you-go) marker in the listing currency.
let billPrimary: string;
let billRest: string;

if (isOfficial) {
	billPrimary = '官方按量';
	billRest = `${currencySymbol}/1M · 无月费，随用随付`;
} else if (primaryPlan && primaryPlan.baseFee > 0) {
	const planSymbol = primaryPlan.currency === 'CNY' ? '¥' : '$';
	const pct = typeof primaryPlan.feePct === 'number' ? primaryPlan.feePct : 0;
	billPrimary = `月费 ${planSymbol}${fmtTrim(primaryPlan.baseFee)}`;
	const extra: string[] = [];
	if (pct > 0) {
		billPrimary += ` + ${pct}%`;
		const actual = planActualMonthly(primaryPlan, primaryPlan.currency);
		extra.push(`≈ ${planSymbol}${fmtTrim(actual)}/月`);
	} else if (pct === 0) {
		extra.push('无附加费');
	}
	extra.push(primaryPlan.quotaType === 'credits' ? '积分额度池' : '共享额度池');
	billRest = extra.join(' · ');
} else {
	billPrimary = '订阅聚合';
	billRest = '按共享额度池计费';
}

// --- ProviderTable rows ----------------------------------------------------
// Metrics: derived from provider.plans (primaryPlan) via computePlanMetrics,
// falling back to computeRowMetrics if no plan exists.
type SortableRow = {
	modelId: string;
	modelName: string;
	modelHref: string;
	price: ProviderWithModels['modelRows'][number]['price'];
	nativeCurrency: Currency;
	credits: number | null;
	quota90: number | null;
	quota95: number | null;
	mPerCur: number | null;
	mPerCurCny: number | null;
	curPerM: number | null;
	curPerMCny: number | null;
	_sort: number; // raw curPerM (USD), Infinity when null
};

const sortable: SortableRow[] = provider.modelRows.map((row) => {
	const mUsd = primaryPlan
		? computePlanMetrics(row.price, primaryPlan, DEFAULT_MIX, 'USD', provider.currency, row.modelQuota, row.multiplier)
		: computeRowMetrics(row.price, row.credits, provider.billing, DEFAULT_MIX, 'USD');
	const mCny = primaryPlan
		? computePlanMetrics(row.price, primaryPlan, DEFAULT_MIX, 'CNY', provider.currency, row.modelQuota, row.multiplier)
		: computeRowMetrics(row.price, row.credits, provider.billing, DEFAULT_MIX, 'CNY');
	const mUsd95 = primaryPlan
		? computePlanMetrics(row.price, primaryPlan, MIX_95_4_1, 'USD', provider.currency, row.modelQuota, row.multiplier)
		: null;

	const quota90 = mUsd.quotaM !== null ? round1(mUsd.quotaM) : row.quota90;
	const quota95 = mUsd95?.quotaM != null ? round1(mUsd95.quotaM) : row.quota95;

	return {
		modelId: row.modelId,
		modelName: row.modelName,
		modelHref: `/models/${row.modelId}`,
		price: row.price,
		nativeCurrency: provider.currency,
		credits: row.modelQuota ?? (primaryPlan ? primaryPlan.quotaAmount : row.credits),
		quota90,
		quota95,
		mPerCur: mUsd.mPerCur === null ? null : round1(mUsd.mPerCur),
		mPerCurCny: mCny.mPerCur === null ? null : round1(mCny.mPerCur),
		curPerM: mUsd.curPerM === null ? null : round1(mUsd.curPerM),
		curPerMCny: mCny.curPerM === null ? null : round1(mCny.curPerM),
		_sort: mUsd.curPerM === null ? Number.POSITIVE_INFINITY : mUsd.curPerM,
	};
});

sortable.sort((a, b) => a._sort - b._sort);

// Drop the internal sort key before handing rows to the display component.
const rows = sortable.map(({ _sort, ...row }, i) => ({
	...row,
	rank: i + 1,
	isBest: i === 0,
}));

const mixLabel = '缓存90/输入9/输出1';
const pageTitle = provider.name;
const pageDescription = isOfficial
	? `${provider.name} 各模型的官方按量价格明细`
	: `${provider.name} 各模型的月费、月额度与每元产出明细`;
const sectionTitle = isOfficial ? '官方按量价格' : '模型价格与月配额';
const planNote = primaryPlan && !isOfficial ? `（套餐：${primaryPlan.name}）` : '';
const sectionSub = isOfficial
	? '官方 API 按 token 计费，无月费与额度池'
	: `按每元额度降序，第 1 行为最佳值 · 折算配比 ${mixLabel}${planNote ? ' · ' + planNote : ''}`;
---

<Layout title={pageTitle} description={pageDescription} activeNav="providers">
	<div class="detail-page">
		<nav class="breadcrumb" aria-label="面包屑">
			<a href="/providers">订阅商</a>
			<span class="bc-sep" aria-hidden="true">/</span>
			<span class="bc-current" aria-current="page">{provider.name}</span>
		</nav>

		<header class="page-head">
			<div class="head-row flex flex-wrap items-center justify-between gap-4">
				<div class="flex items-center gap-3">
					<h1 class="provider-title">{provider.name}</h1>
					<Badge kind={provider.kind} />
				</div>
				<div class="provider-links flex flex-wrap items-center gap-2">
					{provider.websiteUrl && (
						<a
							href={provider.websiteUrl}
							target="_blank"
							rel="noopener noreferrer"
							class="inline-flex items-center gap-1 text-xs px-2.5 py-1 rounded-md border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-300 hover:text-blue-600 dark:hover:text-blue-400 hover:border-blue-400 transition"
							title="访问官网"
						>
							🌐 官网
						</a>
					)}
					{provider.pricingUrl && (
						<a
							href={provider.pricingUrl}
							target="_blank"
							rel="noopener noreferrer"
							class="inline-flex items-center gap-1 text-xs px-2.5 py-1 rounded-md border border-blue-200 dark:border-blue-900/50 bg-blue-50/60 dark:bg-blue-950/30 text-blue-600 dark:text-blue-400 hover:bg-blue-100 dark:hover:bg-blue-900/40 transition font-medium"
							title="查看官方价格与套餐页面"
						>
							🔗 价格 / 订阅页 ↗
						</a>
					)}
					{provider.docUrl && (
						<a
							href={provider.docUrl}
							target="_blank"
							rel="noopener noreferrer"
							class="inline-flex items-center gap-1 text-xs px-2.5 py-1 rounded-md border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-300 hover:text-blue-600 dark:hover:text-blue-400 hover:border-blue-400 transition"
							title="开发接入文档"
						>
							📖 文档
						</a>
					)}
				</div>
			</div>
			<p class="billing-line">
				<span class="bill-primary">{billPrimary}</span>
				{billRest && (
					<span class="bill-rest">
						<span class="bill-sep" aria-hidden="true">·</span>
						{billRest}
					</span>
				)}
			</p>
			{provider.plans && provider.plans.length > 0 && (
				<div class="plans-strip flex flex-wrap gap-2 pt-2">
					{provider.plans.map((pl) => {
						const rateLimitNote = formatRateLimitNote(pl.rateLimit);
						const isLimit = pl.rateLimit?.hasLimit === 'yes';
						const isSelected = primaryPlan?.id === pl.id;
						return (
							<div class={`plan-badge flex items-center gap-1.5 px-3 py-1.5 rounded-lg border text-xs ${isSelected ? 'border-blue-500/40 bg-blue-50/60 dark:bg-blue-950/20 ring-1 ring-blue-500/20' : 'border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900/50'}`}>
								<span class="font-semibold text-slate-800 dark:text-slate-200">{pl.name}</span>
								<span class="text-slate-500">
									{pl.baseFee > 0 ? `${pl.currency === 'USD' ? '$' : '¥'}${pl.baseFee}/月` : '按量/0月费'}
								</span>
								{pl.quotaAmount > 0 && (
									<span class="px-1.5 py-0.5 rounded bg-blue-500/10 text-blue-600 dark:text-blue-400 font-medium">
										{pl.quotaType === 'credits' ? `${pl.quotaAmount.toLocaleString()} 点` : `${pl.quotaCurrency === 'USD' ? '$' : '¥'}${pl.quotaAmount} 额度`}
									</span>
								)}
								{rateLimitNote && (
									<span class={
										pl.rateLimit?.hasLimit === 'yes'
											? "px-1.5 py-0.5 rounded bg-amber-500/10 text-amber-600 dark:text-amber-400"
											: pl.rateLimit?.hasLimit === 'no'
											? "px-1.5 py-0.5 rounded bg-emerald-500/10 text-emerald-600 dark:text-emerald-400"
											: "px-1.5 py-0.5 rounded bg-slate-500/10 text-slate-600 dark:text-slate-400"
									}>
										{rateLimitNote}
									</span>
								)}
							</div>
						);
					})}
				</div>
			)}
		</header>

		<div class="mix-panel">
			<MixSlider label="Token 用量配比（默认 90 / 9 / 1）" />
			<p class="mix-note">
				拖拽配比实时重算即将上线 —— 当前下方表格按默认 90 / 9 / 1 配比计算。
			</p>
		</div>

		<section class="pt-card" aria-label={sectionTitle}>
			<div class="pt-head">
				<div class="pt-titles">
					<h2 class="pt-title">{sectionTitle}</h2>
					<p class="pt-sub">{sectionSub}</p>
				</div>
				<span class="pt-count">共 {rows.length} 个模型</span>
			</div>

			{rows.length > 0 ? (
				<ProviderTable rows={rows} mixLabel={mixLabel} />
			) : (
				<p class="pt-empty">该订阅商暂无模型数据</p>
			)}
		</section>
	</div>
</Layout>

<style>
	.detail-page {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
	}

	/* --- Breadcrumb ------------------------------------------------------ */
	.breadcrumb {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.8125rem;
		line-height: 1.5;
		color: var(--color-text-muted);
	}

	.breadcrumb a {
		color: var(--color-text-muted);
		text-decoration: none;
		transition: color 150ms ease;
	}

	.breadcrumb a:hover {
		color: var(--color-accent);
	}

	.bc-sep {
		color: var(--color-border);
		user-select: none;
	}

	.bc-current {
		color: var(--color-text);
		font-weight: 500;
	}

	/* --- Page header ----------------------------------------------------- */
	.page-head {
		display: flex;
		flex-direction: column;
		gap: 0.4375rem;
	}

	.head-row {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.625rem;
	}

	.provider-title {
		margin: 0;
		font-size: 1.875rem;
		font-weight: 800;
		line-height: 1.25;
		letter-spacing: -0.01em;
		color: var(--color-text);
	}

	.billing-line {
		display: flex;
		align-items: baseline;
		flex-wrap: wrap;
		gap: 0.375rem;
		margin: 0;
		font-size: 0.875rem;
		line-height: 1.6;
		color: var(--color-text);
		font-variant-numeric: tabular-nums;
	}

	.bill-primary {
		font-weight: 600;
	}

	.bill-rest {
		color: var(--color-text-muted);
	}

	.bill-sep {
		margin-right: 0.375rem;
		color: var(--color-border);
		user-select: none;
	}

	/* --- Usage-mix strip -------------------------------------------------- */
	.mix-panel {
		width: 100%;
		max-width: 42rem;
	}

	.mix-note {
		margin: 0.4375rem 0.125rem 0;
		font-size: 0.75rem;
		line-height: 1.5;
		color: var(--color-text-muted);
	}

	/* --- Table card -------------------------------------------------------- */
	.pt-card {
		display: flex;
		flex-direction: column;
		gap: 0.625rem;
	}

	.pt-head {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 1rem;
		padding: 0 0.125rem;
	}

	.pt-titles {
		display: flex;
		flex-direction: column;
		gap: 0.1875rem;
		min-width: 0;
	}

	.pt-title {
		margin: 0;
		font-size: 1.0625rem;
		font-weight: 700;
		line-height: 1.4;
		color: var(--color-text);
		letter-spacing: 0.01em;
	}

	.pt-sub {
		margin: 0;
		font-size: 0.75rem;
		line-height: 1.5;
		color: var(--color-text-muted);
	}

	.pt-count {
		flex: none;
		display: inline-flex;
		align-items: center;
		padding: 0.125rem 0.625rem;
		border-radius: 9999px;
		border: 1px solid var(--color-border);
		background: var(--color-surface);
		font-size: 0.75rem;
		font-weight: 500;
		color: var(--color-text-muted);
		white-space: nowrap;
	}

	.pt-empty {
		margin: 0;
		padding: 2.25rem 1rem;
		text-align: center;
		font-size: 0.875rem;
		color: var(--color-text-muted);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-card);
		background: var(--color-surface);
	}
</style>
