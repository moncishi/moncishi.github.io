---
/**
 * RankTable — single-model comparison table (concept 03-model-compare-desktop).
 *
 * For ONE model, compares every provider/channel carrying it, ranked by
 * currency-per-M ascending (best value = #1, highlighted). Pure display: the
 * parent page computes the metrics (via src/lib/pricing.ts) and passes rows
 * already sorted by curPerM ascending, best first.
 *
 * Props:
 *  - modelName: e.g. "GLM-5.2". Used for the table's accessible caption only;
 *    the page owns the visible model header.
 *  - rows: ChannelRow[] pre-sorted by curPerM ascending (rank 1 = best). Every
 *    money row carries BOTH the USD and the CNY raw values so the page can flip
 *    currency client-side (data-price contract — see CurrencyToggle.astro).
 *    Money cells render the USD default server-side and tag the element with
 *    canonical data-usd / data-cny attrs; CurrencyToggle swaps the text on
 *    toggle. quotaM is currency-free and stays static.
 *
 * Behaviour:
 *  - Every row is genuinely clickable: the provider cell holds an <a> whose
 *    ::after is stretched over the entire row (stretched-link pattern), so
 *    clicking anywhere on the row — or the trailing "查看订阅商详情 →"
 *    affordance — opens that provider's detail page (/providers/[id]).
 *  - The #1 row is highlighted (accent-soft bg + blue left bar + "最佳值" pill
 *    next to its bold blue currency/M value).
 *  - Rank cells render circular number badges (#1 filled accent, #2/#3 soft,
 *    the rest neutral).
 *  - 月费 renders "$10.7" by default; a null/zero monthlyFeeUsd means 按量付费
 *    for official channels and shows "按量" (no data-price node).
 *  - Numeric cells are right-aligned and use tabular-nums.
 *
 * Null-safety: any missing metric renders "—"; rows with no providerHref are
 * rendered read-only (no stretched link, no affordance). No data fetch, no
 * content collections, no framework deps.
 */
import Badge from './Badge.astro';
import { fmtMoneyPrecise, fmtMPrecise, formatPrecision3 } from '../lib/pricing';

interface ChannelRow {
	providerId: string;
	providerName: string;
	planName?: string;
	rateLimitNote?: string;
	kind: 'official' | 'subscription';
	providerHref: string;
	/** Monthly bill in USD. null / ≤ 0 → 按量付费 (pay-as-you-go). */
	monthlyFeeUsd: number | null;
	/** Monthly bill in CNY (FX-converted, same pool), or null for pay-as-you-go. */
	monthlyFeeCny: number | null;
	quotaM: number | null;
	/** M tokens per USD — higher is better. */
	mPerCurUsd: number | null;
	/** M tokens per CNY — higher is better. */
	mPerCurCny: number | null;
	/** USD cost per M token — lower is better. */
	curPerMUsd: number | null;
	/** CNY cost per M token — lower is better. */
	curPerMCny: number | null;
	rank: number;
}

interface Props {
	modelName: string;
	rows?: ChannelRow[];
}

const { modelName, rows = [] } = Astro.props;

/** Treat null / undefined / NaN as absent. */
function normNum(v: number | null | undefined): number | null {
	return typeof v === 'number' && Number.isFinite(v) ? v : null;
}

/**
 * Canonical attribute form for the data-price contract: `String(parseFloat(x))`
 * must round-trip exactly (no "$"/"¥", no commas, no trailing ".0"). For the
 * 1-dp ratio columns (mPerCur / curPerM). null → null (no attr emitted).
 */
function canon(v: number | null | undefined): string | null {
	const n = normNum(v);
	if (n === null) return null;
	return String(Number(n.toFixed(1)));
}

/** 2-dp variant for the monthly fee (values may need cent precision). */
function canon2(v: number | null | undefined): string | null {
	const n = normNum(v);
	if (n === null) return null;
	return String(Number(n.toFixed(2)));
}

/**
 * Money-ish fee formatting: up to 2 decimals, trailing ".00"/".0" trimmed
 * ("$10", "$10.7", "$10.75"). Returns null when the fee is absent or ≤ 0 —
 * callers render 按量.
 */
function feeText(v: number | null | undefined): string | null {
	const n = normNum(v);
	if (n === null || n <= 0) return null;
	return n.toFixed(2).replace(/\.?0+$/, '');
}

/**
 * One-decimal display value with thousands grouping, trailing ".0" trimmed
 * ("15,136.5", "1,413.8", "0.5"). Matches the fmtM/fmtMoney conventions in
 * src/lib/pricing.ts (1 dp display). null → "—".
 */
function fmt1(v: number | null | undefined): string | null {
	const n = normNum(v);
	if (n === null) return null;
	const r = Math.round((n + Number.EPSILON) * 10) / 10;
	const [int, dec] = r.toFixed(1).split('.');
	const grouped = int.replace(/\B(?=(\d{3})+(?!\d))/g, ',');
	return dec === '0' ? grouped : `${grouped}.${dec}`;
}

// Page is expected to always pass a rank-1 row (it pre-sorts), but fall back
// to the first row when it doesn't so the highlight can never be missing.
const hasRankOne = rows.some((r) => normNum(r.rank) === 1);

function isBest(row: ChannelRow, index: number): boolean {
	if (hasRankOne) return normNum(row.rank) === 1;
	return index === 0 && rows.length > 0;
}

function rankBadgeClass(rank: number | null | undefined): string {
	const n = normNum(rank);
	if (n === null || n < 1) return 'rt-rank rt-rank--plain';
	if (n === 1) return 'rt-rank rt-rank--one';
	if (n === 2 || n === 3) return 'rt-rank rt-rank--top';
	return 'rt-rank rt-rank--plain';
}

function safeKind(kind: ChannelRow['kind'] | null | undefined): ChannelRow['kind'] | undefined {
	return kind === 'official' || kind === 'subscription' ? kind : undefined;
}

const hasRows = rows.length > 0;
const colSpan = 7;
---

<section class="rt-card" aria-label={`${modelName} 订阅商对比`}>
	<div class="rt-head">
		<div class="rt-titles">
			<h2 class="rt-title">订阅商对比</h2>
			<p class="rt-sub">
				按 货币/M 升序，最佳值置顶 · 点击行查看订阅商详情
			</p>
		</div>
		{hasRows && <span class="rt-count">共 {rows.length} 家</span>}
	</div>

	<div class="rt-scroll">
		<table class="rt-table">
			<caption class="rt-sr-only">
				{modelName} 在各订阅商的月费与月度额度对比，按 货币/M
				由低到高排序
			</caption>

			<thead>
				<tr>
					<th scope="col" class="rt-th rt-th--rank">排名</th>
					<th scope="col" class="rt-th rt-th--provider">订阅商</th>
					<th scope="col" class="rt-th rt-th--fee">月费</th>
					<th scope="col" class="rt-th rt-th--quota">月额度 M</th>
					<th scope="col" class="rt-th rt-th--mper">M/货币</th>
					<th scope="col" class="rt-th rt-th--curper">货币/M</th>
					<th scope="col" class="rt-th rt-th--action">
						<span class="rt-sr-only">操作</span>
					</th>
				</tr>
			</thead>

			<tbody>
				{!hasRows && (
					<tr>
						<td colspan={colSpan} class="rt-empty">
							暂无比价数据
						</td>
					</tr>
				)}

				{
					rows.map((row, index) => {
						const best = isBest(row, index);
						const href = row.providerHref && row.providerHref.trim() ? row.providerHref : null;
						// Fee: present only when a real monthly bill exists (USD and
						// CNY go together — both derive from the same pool). SSR text
						// stays the USD default; attrs carry both canonical numbers.
						const feeUsd = normNum(row.monthlyFeeUsd);
						const hasFee = feeUsd !== null && feeUsd > 0;
						const feeUsdText = hasFee ? fmtMoneyPrecise(row.monthlyFeeUsd, 'USD', 2) : null;
						const feeCnyText = hasFee ? fmtMoneyPrecise(row.monthlyFeeCny, 'CNY', 2) : null;
						const quota = fmtMPrecise(row.quotaM, 3);
						const mPerCurUsd = formatPrecision3(row.mPerCurUsd, 3);
						const mPerCurCny = formatPrecision3(row.mPerCurCny, 3);
						const curPerMUsdDisp = fmtMoneyPrecise(row.curPerMUsd, 'USD', 3);
						const curPerMCnyDisp = fmtMoneyPrecise(row.curPerMCny, 'CNY', 3);
						const kind = safeKind(row.kind);

						return (
							<tr
								class:list={{
									'rt-row': true,
									'rt-row--best': best,
									'rt-row--link': href !== null,
								}}
							>
								<td class="rt-cell rt-cell--rank">
									<span
										class={rankBadgeClass(row.rank)}
										aria-label={`第 ${row.rank ?? '?'} 名`}
									>
										{row.rank ?? '—'}
									</span>
								</td>

								<td class="rt-cell rt-cell--provider">
									{href ? (
										<a
											class="rt-provider-link"
											href={href}
											aria-label={`查看 ${row.providerName} 订阅商详情`}
										>
											<span class="rt-provider-name">{row.providerName}</span>
											{row.planName && (
												<span class="text-xs px-1.5 py-0.5 rounded bg-amber-500/10 text-amber-600 dark:text-amber-400 font-medium">
													{row.planName}
												</span>
											)}
											{row.rateLimitNote && (
												<span
													class="text-xs px-1.5 py-0.5 rounded bg-blue-500/10 text-blue-600 dark:text-blue-400"
													title={`限额详情: ${row.rateLimitNote}`}
												>
													{row.rateLimitNote}
												</span>
											)}
											<Badge kind={kind} />
										</a>
									) : (
										<span class="rt-provider-static">
											<span class="rt-provider-name">{row.providerName}</span>
											{row.planName && (
												<span class="text-xs px-1.5 py-0.5 rounded bg-amber-500/10 text-amber-600 dark:text-amber-400 font-medium">
													{row.planName}
												</span>
											)}
											{row.rateLimitNote && (
												<span
													class="text-xs px-1.5 py-0.5 rounded bg-blue-500/10 text-blue-600 dark:text-blue-400"
													title={`限额详情: ${row.rateLimitNote}`}
												>
													{row.rateLimitNote}
												</span>
											)}
											<Badge kind={kind} />
										</span>
									)}
								</td>

								<td class="rt-cell rt-cell--num rt-cell--fee">
									{hasFee ? (
										<span
											class="rt-money"
											data-price
											data-usd={feeUsdText}
											data-cny={feeCnyText}
										>
											{feeUsdText}
										</span>
									) : (
										<span class="rt-payg">按量</span>
									)}
								</td>

								<td class="rt-cell rt-cell--num rt-cell--quota">
									{quota}
								</td>

								<td class="rt-cell rt-cell--num rt-cell--mper">
									{mPerCurUsd !== null ? (
										<span
											data-ratio
											data-usd={mPerCurUsd}
											data-cny={mPerCurCny}
										>
											{mPerCurUsd}
										</span>
									) : (
										<span class="rt-null">—</span>
									)}
								</td>

								<td class="rt-cell rt-cell--num rt-cell--curper">
									<span class="rt-numwrap">
										{best && <span class="rt-best">最佳值</span>}
										{row.curPerMUsd !== null ? (
											<span
												class:list={['rt-money', best && 'rt-money--best']}
												data-price
												data-usd={curPerMUsdDisp}
												data-cny={curPerMCnyDisp}
											>
												{curPerMUsdDisp}
											</span>
										) : (
											<span class="rt-null">—</span>
										)}
									</span>
								</td>

								<td
									class="rt-cell rt-cell--action"
									aria-hidden={href === null ? 'true' : undefined}
								>
									{href && (
										<span class="rt-go">
											<span class="rt-go-text">查看订阅商详情</span>
											<span class="rt-go-arrow" aria-hidden="true">→</span>
										</span>
									)}
								</td>
							</tr>
						);
					})
				}
			</tbody>
		</table>
	</div>
</section>

<style>
	.rt-card {
		background: var(--color-surface);
		border-radius: var(--radius-card);
		box-shadow: var(--shadow-card);
		border: 1px solid var(--color-border);
		overflow: hidden;
	}

	/* --- Card header ----------------------------------------------------- */
	.rt-head {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 1rem;
		padding: 1rem 1.25rem 0.875rem;
	}

	.rt-titles {
		display: flex;
		flex-direction: column;
		gap: 0.1875rem;
		min-width: 0;
	}

	.rt-title {
		margin: 0;
		font-size: 1.0625rem;
		font-weight: 700;
		line-height: 1.4;
		color: var(--color-text);
		letter-spacing: 0.01em;
	}

	.rt-sub {
		margin: 0;
		font-size: 0.75rem;
		line-height: 1.5;
		color: var(--color-text-muted);
	}

	.rt-count {
		flex: none;
		display: inline-flex;
		align-items: center;
		padding: 0.125rem 0.625rem;
		border-radius: 9999px;
		border: 1px solid var(--color-border);
		background: color-mix(in srgb, var(--color-bg) 55%, transparent);
		font-size: 0.75rem;
		font-weight: 500;
		color: var(--color-text-muted);
		white-space: nowrap;
	}

	/* --- Scroll container (narrow viewports) ---------------------------- */
	.rt-scroll {
		overflow-x: auto;
	}

	.rt-table {
		width: 100%;
		min-width: 46rem;
		border-collapse: collapse;
	}

	/* Screen-reader-only caption / empty header label. */
	.rt-sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0 0 0 0);
		white-space: nowrap;
		border: 0;
	}

	/* --- Header row ------------------------------------------------------ */
	.rt-th {
		padding: 0.5625rem 0.875rem;
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.02em;
		text-align: left;
		color: var(--color-text-muted);
		background: color-mix(in srgb, var(--color-bg) 45%, transparent);
		border-bottom: 1px solid var(--color-border);
		white-space: nowrap;
	}

	.rt-th--rank {
		width: 4rem;
		text-align: center;
	}

	.rt-th--provider {
		width: auto;
	}

	.rt-th--fee {
		width: 6rem;
		text-align: right;
	}

	.rt-th--quota {
		width: 7.5rem;
		text-align: right;
	}

	.rt-th--mper {
		width: 7.5rem;
		text-align: right;
	}

	.rt-th--curper {
		width: 8.5rem;
		text-align: right;
	}

	.rt-th--action {
		width: 11rem;
	}

	/* --- Body cells ------------------------------------------------------ */
	.rt-cell {
		padding: 0.6875rem 0.875rem;
		font-size: 0.875rem;
		line-height: 1.5;
		color: var(--color-text);
		border-bottom: 1px solid var(--color-border);
		vertical-align: middle;
	}

	.rt-cell--num {
		text-align: right;
		font-variant-numeric: tabular-nums;
		white-space: nowrap;
	}

	.rt-cell--rank {
		text-align: center;
	}

	/* --- Rank badge ------------------------------------------------------ */
	.rt-rank {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-width: 1.5rem;
		height: 1.5rem;
		padding: 0 0.375rem;
		border-radius: 9999px;
		border: 1px solid var(--color-border);
		background: var(--color-surface);
		font-size: 0.75rem;
		font-weight: 700;
		line-height: 1;
		font-variant-numeric: tabular-nums;
		white-space: nowrap;
	}

	.rt-rank--one {
		background: var(--color-accent);
		border-color: var(--color-accent);
		color: #ffffff;
	}

	.rt-rank--top {
		background: color-mix(in srgb, var(--color-accent-soft) 70%, transparent);
		border-color: color-mix(in srgb, var(--color-accent) 30%, transparent);
		color: var(--color-accent);
	}

	.rt-rank--plain {
		color: var(--color-text-muted);
	}

	/* --- Provider cell + stretched whole-row link ----------------------- */
	.rt-cell--provider {
		min-width: 13rem;
	}

	.rt-row {
		position: relative;
		transition: background 150ms ease;
	}

	/* Clickable rows only (href present). */
	.rt-row--link {
		cursor: pointer;
	}

	.rt-row--link:hover {
		background: color-mix(in srgb, var(--color-accent-soft) 45%, transparent);
	}

	.rt-row--best {
		background: var(--color-accent-soft);
	}

	.rt-row--best:hover {
		background: color-mix(in srgb, var(--color-accent-soft) 85%, var(--color-accent) 15%);
	}

	/* Blue left bar on the highlighted row (inset shadow: no layout shift). */
	.rt-row--best .rt-cell--rank {
		box-shadow: inset 3px 0 0 var(--color-accent);
	}

	/* Drop the hairline under the last body row. */
	.rt-row:last-child .rt-cell {
		border-bottom-color: transparent;
	}

	.rt-provider-link,
	.rt-provider-static {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		max-width: 100%;
		min-width: 0;
		color: inherit;
		text-decoration: none;
	}

	/* Stretched link: anchor's ::after covers the whole row, so a click
	   anywhere on the row (or the trailing affordance) opens the provider. */
	.rt-provider-link::after {
		content: '';
		position: absolute;
		inset: 0;
	}

	.rt-provider-name {
		font-weight: 600;
		font-size: 0.9375rem;
		color: var(--color-text);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
		transition: color 150ms ease;
	}

	.rt-row--link:hover .rt-provider-name,
	.rt-row--link:focus-within .rt-provider-name {
		color: var(--color-accent);
	}

	.rt-provider-link:focus-visible {
		outline: 2px solid var(--color-accent);
		outline-offset: 2px;
		border-radius: 0.25rem;
	}

	/* --- Money / value cells -------------------------------------------- */
	.rt-money {
		font-variant-numeric: tabular-nums;
		font-weight: 600;
	}

	.rt-money--best {
		color: var(--color-accent);
		font-weight: 700;
	}

	.rt-null {
		color: var(--color-text-muted);
	}

	/* 按量付费 (pay-as-you-go) marker for fee-less official channels. */
	.rt-payg {
		color: var(--color-text-muted);
	}

	/* Right-aligned cluster: 最佳值 pill + bold currency/M value. */
	.rt-numwrap {
		display: inline-flex;
		align-items: center;
		justify-content: flex-end;
		gap: 0.5rem;
		min-width: 0;
	}

	.rt-best {
		display: inline-flex;
		align-items: center;
		padding: 0 0.4375rem;
		border-radius: 9999px;
		border: 1px solid color-mix(in srgb, var(--color-accent) 35%, transparent);
		background: color-mix(in srgb, var(--color-accent) 13%, transparent);
		color: var(--color-accent);
		font-size: 0.6875rem;
		font-weight: 600;
		line-height: 1.5;
		letter-spacing: 0.01em;
		white-space: nowrap;
	}

	/* --- Trailing affordance -------------------------------------------- */
	.rt-cell--action {
		text-align: right;
		white-space: nowrap;
	}

	.rt-go {
		display: inline-flex;
		align-items: center;
		gap: 0.25rem;
		font-size: 0.8125rem;
		color: var(--color-accent);
		white-space: nowrap;
	}

	.rt-go-text {
		font-weight: 500;
	}

	.rt-go-arrow {
		font-size: 0.875rem;
		transition: transform 150ms ease;
	}

	.rt-row--link:hover .rt-go-arrow {
		transform: translateX(0.1875rem);
	}

	/* --- Empty state ----------------------------------------------------- */
	.rt-empty {
		padding: 2.25rem 1rem;
		text-align: center;
		font-size: 0.875rem;
		color: var(--color-text-muted);
		border-bottom: 0;
	}
</style>
